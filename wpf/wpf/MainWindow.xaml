<Window x:Class="wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator i Rejestr Wynagrodzeń" Height="500" Width="850"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek / Etykieta podtytułu -->
        <TextBlock x:Name="lblAutor" Text="Kalkulator Wynagrodzeń - Autor: 00000000000" 
                   HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Grid.Row="0"/>

        <!-- Główna zawartość podzielona na kolumny -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL (Dane Wejściowe) -->
            <GroupBox Header="Dane Wejściowe" Grid.Column="0" Margin="0,0,10,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Wynagrodzenie brutto w PLN" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBrutto" Height="25" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <!-- Rodzaj Umowy -->
                    <GroupBox Header="Rodzaj Umowy" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="rbUmowaPracy" Content="Umowa o pracę" IsChecked="True" Margin="0,0,0,10"/>
                            <RadioButton x:Name="rbUmowaZlecenie" Content="Umowa zlecenie"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Ulga dla młodych -->
                    <CheckBox x:Name="chkUlga" Content="Ulga dla młodych &lt; 26 lat" Margin="0,0,0,30"/>

                    <!-- Przycisk Oblicz i Zapisz -->
                    <Button x:Name="btnObliczZapisz" Content="OBLICZ I ZAPISZ" Height="45" 
                            Background="#1E73BE" Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="BtnObliczZapisz_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- RIGHT PANEL (Wyniki i Historia) -->
            <GroupBox Header="Wyniki i Historia" Grid.Column="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Główny wynik (duża, pogrubiona, zielona czcionka) -->
                    <TextBlock x:Name="lblWynikNetto" Text="Wynagrodzenie netto: 0,00 PLN" 
                               FontSize="18" FontWeight="Bold" Foreground="ForestGreen" Margin="0,0,0,10" Grid.Row="0"/>

                    <!-- Sekcja Szczegóły Składek i Podatków -->
                    <GroupBox Header="Szczegóły Składek i Podatków" Grid.Row="1" Margin="0,0,0,10" Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="lblZus" Text="Składki ZUS (społeczne): 0,00 PLN" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblZdrowotna" Text="Składka zdrowotna: 0,00 PLN" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblPit" Text="Zaliczka na podatek PIT: 0,00 PLN"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tabela Rejestr Wynagrodzeń -->
                    <GroupBox Header="Rejestr Wynagrodzeń" Grid.Row="2" Padding="5">
                        <DataGrid x:Name="dgvRejestr" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                                <DataGridTextColumn Header="Kwota Brutto" Binding="{Binding KwotaBrutto, StringFormat={}{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="Umowa" Binding="{Binding TypUmowy}" Width="*"/>
                                <DataGridTextColumn Header="Netto" Binding="{Binding Netto, StringFormat={}{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="Ulga" Binding="{Binding Ulga}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>